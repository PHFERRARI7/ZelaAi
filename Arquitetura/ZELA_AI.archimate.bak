  <folder name="Technology &amp; Physical" id="id-c202e213009d436498a53bc9cc896aba" type="technology"/>
  <folder name="Motivation" id="id-ed99668f1d6c466988179fa366ac8bda" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="População / Cidadão" id="id-81bcb67c5e4c4042962c706725d5b692"/>
    <element xsi:type="archimate:Driver" name="A deterioração e a falta de padronização dos espaços de circulação pública geram transtornos diários, aumentam o risco de acidentes e desencorajam a ocupação segura e eficiente do espaço urbano pela sociedade civil" id="id-a0f4e4affa2a4c5b949482619ff3bc6c"/>
    <element xsi:type="archimate:Goal" name="Permitir que o cidadão registre e acompanhe problemas urbanos sem barreira de acesso" id="id-9f3a37649ad24307821a229a3dfdbf40"/>
    <element xsi:type="archimate:Goal" name="Permitir que o cidadão envie seu feedback sobre o serviço à prefeitura" id="id-74f63041e0ed45b18ad7beb618fdaa9e"/>
    <element xsi:type="archimate:Outcome" name="Cidadãos abrem e acompanham chamados pelo WhatsApp, sem instalar app nem se cadastrar" id="id-944ae521da8c4c7bb58b926b180683fc"/>
    <element xsi:type="archimate:Outcome" name="70% das notas enviadas pelos cidadãos, demonstrem satisfação com o serviço prestado pela prefeitura" id="id-ba080a113dc6486f8be0b5190560342e"/>
    <element xsi:type="archimate:Value" name="Value" id="id-22efbe55d7264e0cb14f19e93bb6b95b"/>
    <element xsi:type="archimate:Value" name="Value" id="id-459a9fec38ab4518a29b1c7f9d772bfb"/>
    <element xsi:type="archimate:Assessment" name="Plataforma de zeladoria que não depende de instalação de app e cadastros prévios " id="id-b1e225025e6247618bfe356713d7f897"/>
    <element xsi:type="archimate:Assessment" name="Enviar pesquisa de satisfação diretamente no whatsapp sobre os serviços prestados" id="id-a4d4721f06b54fcfaa432953de6789a2"/>
    <element xsi:type="archimate:Requirement" name="Cadastrar chamado" id="id-c28feb6b42f841599022d083f0468485"/>
    <element xsi:type="archimate:Requirement" name="Registrar movimentação dos chamados" id="id-8cda092ff8244e05a10cbda5f26d5377"/>
    <element xsi:type="archimate:Requirement" name="Encerrar chamado" id="id-4985ea6ec07a48ff8b3f68aca5b6cd22"/>
    <element xsi:type="archimate:Constraint" name="Somente pessoas identificadas (CPF e telefone informados) poderão cadastrar chamados para a prefeitura, sendo por mensagem, áudio ou fotos. Ao enviar um chamado, uma IA analisará qual é o setor responsável e redirecionará para o atendente. Em seguida o cidadão recebe seu protocolo com data e hora do registro" id="id-691a8106ae1742128de6831c896359f7"/>
    <element xsi:type="archimate:Constraint" name="A IA direciona o chamado para a equipe responsável. A equipe deverá ir até o local, identificar o problema e consertá-lo. Em seguida, informa a central com registros fotográficos. O sistema deverá armazenar o registro da data e hora do reparo" id="id-8226732abdda4de3a82f9d70a50bdc26"/>
    <element xsi:type="archimate:Constraint" name="A central analisa se o problema foi solucionado pela equipe de campo" id="id-a854c685171c44c190bf5f63bd63367d"/>
    <element xsi:type="archimate:Constraint" name="Ao encerrar o chamado, o cidadão é notificado via WhatsApp" id="id-36c189458f234f0fb4a09e9ab9f05e1c"/>
    <element xsi:type="archimate:Outcome" name="70% dos chamados atendidos cumpridos dentro do prazo" id="id-d87c1e58225541bd8541aabd35ecfdc7"/>
    <element xsi:type="archimate:Requirement" name="Enviar a pesquisa de satisfação por mensagem no WhatsApp " id="id-d8e21bfb00684eb8b0c18ff3061e22ea"/>
    <element xsi:type="archimate:Requirement" name="Capturar a resposta do cidadão e registrá-la ao protocolo" id="id-ed86fd678ab44b1d9947c133c0c59011"/>
    <element xsi:type="archimate:Constraint" name="A pesquisa só é enviada a quem aceitou receber mensagens do Zela Aí, traz o protocolo, a descrição do problema, convidando o cidadão a avaliar o serviço, e opções numeradas de 1 a 5 para ele escolher a resposta." id="id-673dda46a4664c11a1c4787863b41adf"/>
    <element xsi:type="archimate:Constraint" name="A coleta é automática pelo WhatsApp: o sistema reconhece a mensagem como resposta da pesquisa, aceita uma única resposta por protocolo, grava a nota e o comentário opcional no banco de dados do Zela Aí e os envia ao portal 156, ligados ao protocolo, para uso futuro da Prefeitura em relatórios." id="id-a33174498f824d5ebeb8f01f6158f0d4"/>
  </folder>
